# AISD System Configuration

# Application
APP_NAME="AISD Incident Management System"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security
SECRET_KEY="replace-with-a-secure-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://aisd_user:aisd_password@localhost:5432/aisd_db"

# AI & Ollama Configuration
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3.5:4b"
OLLAMA_EMBED_MODEL="nomic-embed-text:latest"
OLLAMA_TIMEOUT_SECONDS=30
AI_FALLBACK_TO_RULES=true

# Optional Cloud Model (Disabled by default)
CLOUD_AI_ENABLED=false
CLOUD_AI_PROVIDER="none"
CLOUD_AI_API_KEY=""

# Remediation Safety Policy (Real Execution Enabled)
REMEDIATION_MOCK_MODE=false
REQUIRE_APPROVAL_FOR_R2=true
REQUIRE_APPROVAL_FOR_R3=true
ALLOW_LOCAL_ENDPOINT_EXECUTION=true

# Endpoint Agent Settings
CENTRAL_SERVER_URL="http://127.0.0.1:8000"
AGENT_HEARTBEAT_INTERVAL=30
AGENT_SYNC_INTERVAL=15
